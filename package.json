{
  "name": "tick",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "npm run comments:check && eslint",
    "comments:check": "node scripts/strip-comments.mjs --check",
    "comments:remove": "node scripts/strip-comments.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:account": "playwright test --config playwright.account.config.ts",
    "test:e2e:browsers": "playwright install --with-deps chromium",
    "publish": "node scripts/publish-branch.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:start": "node scripts/supabase-cli.mjs start",
    "supabase:start:db": "node scripts/supabase-cli.mjs start -x gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:stop": "node scripts/supabase-cli.mjs stop",
    "supabase:status": "node scripts/supabase-cli.mjs status",
    "supabase:db:reset": "node scripts/supabase-cli.mjs db:reset",
    "supabase:db:diff": "node scripts/supabase-cli.mjs db:diff",
    "supabase:db:diff:check": "node scripts/supabase-cli.mjs db:diff:check",
    "supabase:db:lint": "node scripts/supabase-cli.mjs db:lint",
    "supabase:test:db": "node scripts/supabase-cli.mjs test:db",
    "supabase:types:local": "node scripts/supabase-cli.mjs types:local",
    "supabase:prod:db:push": "node scripts/supabase-cli.mjs prod:db:push",
    "supabase:prod:db:dry-run": "node scripts/supabase-cli.mjs prod:db:dry-run",
    "supabase:prod:migrations:repair": "node scripts/supabase-cli.mjs prod:migrations:repair",
    "supabase:prod:types": "node scripts/supabase-cli.mjs prod:types",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check && npm run build",
    "clean": "rm -rf .next out build coverage public/sw.js public/sw.js.map public/swe-worker*.js"
  },
  "dependencies": {
    "@powersync/web": "^2.1.1",
    "@serwist/next": "^9.5.11",
    "@supabase/supabase-js": "^2.105.4",
    "country-flag-icons": "^1.6.17",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.14.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "serwist": "^9.5.11",
    "supabase": "^2.98.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
