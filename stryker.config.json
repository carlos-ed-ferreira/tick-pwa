{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "mutate": [
    "src/lib/domain/task-completion.ts",
    "src/lib/db/entity-metadata.ts",
    "src/lib/supabase/account-cache-baseline.ts"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": { "fileName": "coverage/mutation/mutation.json" },
  "htmlReporter": { "fileName": "coverage/mutation/index.html" },
  "thresholds": { "high": 80, "low": 70, "break": 70 },
  "tempDirName": ".next/stryker-tmp",
  "cleanTempDir": true
}
